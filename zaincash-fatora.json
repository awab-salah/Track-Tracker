iv>\n\n    </nav>\n    </div>\n\n</aside>      <!-- / navigation -->\n\n<!-- content -->\n<article class=\"col-lg-10 col-xxl-10 doc-content\">\n    <style>\n.align-center {\n    display: flex;\n    align-items: center;\n}\n</style>\n<div class=\"doc-content-header\">\n    <div class=\"row justify-content-end align-center\">\n        <div class=\"col-auto\">\n            <a target=\"_blank\" href=\"https://app.fatora.io/login?src=api\">\n                <i class=\"fa fa-lock\"></i> Login to Dashboard\n            </a>\n        </div>\n        <div class=\"col-auto\">\n            <a target=\"_blank\" class=\"btn btn-sm btn-primary btn-rounded\" href=\"https://fatora-api.stoplight.io/docs/API-reference/ZG9jOjE-fatora-rest-api\">\n                <i class=\"fa fa-code\"></i> API Reference\n            </a>\n        </div>\n    </div>\n</div>\n    <div class=\"row justify-content-between doc-content-body\">\n        <article class=\"col-md-10 col-xxl-8\">\n            <!-- ZainCash -->\n            <section id=\"zaincash\">\n                <div class=\"ft-Integration-section-div-img\">\n                    <img src=\"https://fatora.io/api/assets/images/zaincash.png\" alt=\"paywall\">\n                </div>\n                <h1>About ZainCash</h1>\n                <p>\n                    Zaincash is a leading payment gateway provider based in Iraq, offering innovative payment solutions\n                    for businesses across various industries. It facilitates secure and convenient online transactions,\n                    enabling merchants to accept payments from customers through multiple channels.</p>\n                <h3>Supported Countries</h3>\n                <p>\n                </p><ul>\n                    <li>Iraq</li>\n                </ul>\n                <p></p>\n                <h3>Supported Cards</h3>\n                <p>ZainCash supports a variety of major credit and debit cards, including:\n                </p><ul>\n                    <li>Visa</li>\n                    <li>MasterCard</li>\n                </ul>\n                This ensures that customers have multiple options for making payments, enhancing the convenience and\n                accessibility of the payment process.\n                <p></p>\n                <p>\n                    For more information, please check the\n                    <a href=\"https://www.zaincash.iq/\" target=\"_blank\" rel=\"noopener noreferrer\">ZainCash website</a>.\n                </p>\n                <div class=\"rule-info ml-1\">\n                    <div class=\"info\" style=\"display: flex;\">\n                        <i class=\"icon-info-circle text-green fs-24 mr-2\"></i>\n                        <h4>Do You Have a ZainCash Account?</h4>\n                    </div>\n                    <p>You must have a ZainCash account to complete the integration with Fatora. You can create a new\n                        account\n                        <a href=\"https://merchant.zaincash.iq/auth/login\" target=\"_blank\">here</a>\n                    </p>\n                </div>\n            </section>\n            <section id=\"link\">\n                <h2>Link with ZainCash\n                </h2>\n                <p>To start accepting payments using ZainCash, you must provide Fatora with your live ZainCash account\n                    information, including:\n                    <b>\n                        </b></p><ul><b>\n                            <li>Merchant ID - You can request a Merchant ID from ZainCash's support.</li>\n                            <li>Merchant secret - This is used to decode and encode JWT during requests. also must be\n                                requested from ZainCash.</li>\n                            <li>msisdn - The mobile phone number for your wallet, example format: 9647802999569.</li>\n                        </b></ul><b>\n                    </b>\n                <p></p>\n                <h4>Getting ZeinaCash credantial:</h4>\n                <ol class=\"step-list ml-2\">\n                    <li>\n                        <div>\n                            <p><b>Login to your account at the</b><a href=\"https://merchant.zaincash.iq/auth/login\" class=\"external\" target=\"_blank\">ZainCash Account</a>.</p>\n                        </div>\n                    </li>\n                    <li>\n                        <div>\n                            <p>Collect the credantial Keys from your ZeinaCash Account manager.</p>\n                        </div>\n                    </li>\n\n                </ol>\n                <div class=\"rule-info ml-1\">\n                    <div class=\"info\" style=\"display: flex;\">\n                        <i class=\"icon-info-circle text-green fs-24 mr-2\"></i>\n                        <h4>Active wallet</h4>\n                    </div>\n                    <p>You will need an active wallet to start receiving money on.\n                    </p>\n                </div>\n            </section>\n            <!-- /ZainCash -->\n\n            <!-- ZainCash -->\n            <section id=\"zaincash-rtl\" class=\"external-integration\">\n                <div class=\"ft-Integration-section-div-img\">\n                    <img src=\"https://fatora.io/api/assets/images/zaincash.png\" alt=\"paywall\">\n                </div>\n                <h2>نبذة عن ZainCash</h2>\n                <p>\n                    زين كاش هي شركة رائدة في توفير بوابات الدفع مقرها في العراق ، وتقدم حلول دفع مبتكرة للشركات في مختلف\n                    الصناعات. يسهل المعاملات الآمنة والمريحة عبر الإنترنت ، تمكين التجار من قبول المدفوعات من العملاء من\n                    خلال قنوات متعددة.</p>\n                <h3>البلدان المدعومة</h3>\n                <p>\n                </p><ul>\n                    <li>العراق</li>\n                </ul>\n                <p></p>\n                <h3>البطاقات المدعومة</h3>\n                <p>تدعم زين كاش مجموعة متنوعة من بطاقات الائتمان والخصم الرئيسية، بما في ذلك:\n                </p><ul>\n                    <li>فيزا</li>\n                    <li>ماستركارد</li>\n                </ul>\n                هذا يضمن للعملاء خيارات متعددة لإجراء المدفوعات، مما يعزز سهولة الوصول وراحة العملية.\n                <p></p>\n                <p>\n                    لمزيد من المعلومات، يرجى زيارة\n                    <a href=\"https://www.zaincash.iq/\" target=\"_blank\" rel=\"noopener noreferrer\"> الموقع الالكتروني لـ ZainCash</a>.\n                </p>\n                <div class=\"rule-info ml-1\">\n                    <div class=\"info\" style=\"display: flex;\">\n                        <i class=\"icon-info-circle text-green fs-24 mr-2\"></i>\n                        <h4>هل لديك حساب على ZainCash؟</h4>\n                    </div>\n                    <p>يجب أن يكون لديك حساب ZainCash لتتمكن من اتمام الربط مع فاتورة. يمكنك إنشاء حساب جديد\n                        <a href=\"https://merchant.zaincash.iq/auth/login\" target=\"_blank\">هنا</a>\n                    </p>\n                </div>\n            </section>\n            <section id=\"link-rtl\" class=\"external-integration\">\n                <h2>الربط مع ZainCash\n                </h2>\n                <p>لبدء قبول المدفوعات باستخدام ZainCash يجب عليك تزويد Fatora بالمعلومات التالية من حساب ZainCash الخاص بك\n                    <b>\n                        </b></p><ul><b>\n                            <li>Merchant ID - يمكنك طلب معرف التاجر من دعم ZainCash.</li>\n                            <li>Merchant secret - يجب أن يكون أيضا مطلوب من ZainCash</li>\n                            <li>msisdn - رقم الهاتف المحمول لمحفظتك، على النموذج: 9647802999569.</li>\n                        </b></ul><b>\n                    </b>\n                <p></p>\n                <h4>الحصول بيانات المصادقة من ZainCash:</h4>\n\n                <ol class=\"step-list ml-2\">\n                    <li>\n                        <div>\n                            <p><b>قم بتسجيل الدخول إلى</b><a href=\"https://merchant.zaincash.iq/auth/login\" class=\"external\" target=\"_blank\">حسابك\n                                    في ZainCash</a>.</p>\n                        </div>\n                    </li>\n                    <li>\n                        <div>\n                            <p>اجمع بيانات المفاتيح المطلوبة من مدير حساب ZainCash الخاص بك.</p>\n                        </div>\n                    </li>\n                </ol>\n                <div class=\"rule-info ml-1\">\n                    <div class=\"info\" style=\"display: flex;\">\n                        <i class=\"icon-info-circle text-green fs-24 mr-2\"></i>\n                        <h4>المحفظة النشطة</h4>\n                    </div>\n                    <p>ستحتاج إلى محفظة نشطة لبدء تلقي الأموال عليها.\n                    </p>\n                </div>\n            </section>\n            <!-- /ZainCash -->\n            <div class=\"row\">\n    <div class=\"col-md-12\">\n        <div class=\"card\" style=\"border:0px;\">\n            <div class=\"card-body\">\n                <div class=\"row align-items-center\">\n                    <div class=\"col-md-2 text-center\">\n                        <img src=\"https://fatora.io/api/assets/images/intro/technical-support.png\" alt=\"technical-support\">\n                    </div>\n                    <div class=\"col\">\n                        <h3 class=\"card-title mt-2 mt-md-0 text-center text-md-left mb-2\">🛠️ Technical Support</h3>\n                        <div class=\"row\">\n                            <div class=\"col-12 col-sm-12\">\n                                <ul class=\"list-group list-group-minimal\">\n                                    <li class=\"list-group-item\">\n                                      if you need any help you can check our <a href=\"https://fatora.io/en/help-center-en/?src=api\" class=\"external\" target=\"_blank\">help\n                                     center</a>, or contact <a href=\"https://fatora.io/en/support-request/?src=api\" class=\"external\" target=\"_blank\"> support team </a>\n                                    </li>\n                                </ul>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n        </article>\n        <aside class=\"col-md-2 col-xxl-3 d-none d-md-block\">\n            <div class=\"sticky\">\n                <ul id=\"toc\" class=\"nav flex-column toc\">\n                    <li class=\"nav-item\">\n                        <a class=\"nav-link\" href=\"#\" style=\"pointer-events: none;\"><i class=\"icon-menu mr-1\"></i>On this\n                            page</a>\n                    </li>\n                    <li class=\"nav-item\">\n                        <a data-scroll=\"\" class=\"nav-link\" href=\"#zaincash\">ZainCash</a>\n                    </li>\n                    <li class=\"nav-item\">\n                        <a data-scroll=\"\" class=\"nav-link\" href=\"#link\">Link with ZainCash</a>\n                    </li>\n                </ul>\n            </div>\n        </aside>\n    </div>\n</article>\n<!-- / content -->\n\n\n        </div>\n    </div>\n  </section>  \n  <script src=\"https://fatora.io/api/assets/js/prism.js\"></script> \n  <!-- File Highlight plugin -->\n  <script src=\"https://cdn.jsdelivr.net/npm/prismjs@1.29.0/plugins/file-highlight/prism-file-highlight.min.js\"></script>\n   <script src=\"https://fatora.io/api/assets/js/vendor.min.js\"></script>\n  <script type=\"module\" src=\"https://static.cloudflareinsights.com/beacon.min.js/v4513226cdae34746b4dedf0b4dfa099e1781791509496\" integrity=\"sha512-ZE9pZaUXND66v380QUtch/5sE9tPFh2zg45pR2PB0CVkCtOREv2AJKkSidISWkysEuQ0EH8faUU5du78bx87UQ==\" data-cf-beacon=\"{&quot;version&quot;:&quot;2024.11.0&quot;,&quot;token&quot;:&quot;eb3211fc369540abadc4d50c1a4798ce&quot;}\" crossorigin=\"anonymous\"></script>\n\n\n</body></html>",
